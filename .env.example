# Copy to .env (gitignored) and fill in the values you need.
# Anything left commented uses the in-code default.

# ── LLM provider (Phase 2 agent + LLM critic) ──────────────────────────────
# Option 1: OpenRouter (any hosted model via one endpoint)
# PATCHHOLMES_LLM_API_KEY=sk-or-v1-...
# PATCHHOLMES_LLM_MODEL=openrouter/qwen/qwen3-235b-a22b-2507

# Option 2: Local vLLM
# PATCHHOLMES_LLM_MODEL=hosted_vllm/qwen3-235b
# PATCHHOLMES_LLM_BASE_URL=http://localhost:8000/v1
# PATCHHOLMES_LLM_API_KEY=EMPTY

# Option 3: OpenAI (used by some baseline scripts and the LLM listwise critic)
# OPENAI_API_KEY=sk-...

# Optional: pin upstream providers behind OpenRouter (matters for tool-calling
# under heavy concurrency — some providers return 5xx, listed ones don't).
# PATCHHOLMES_OPENROUTER_PROVIDERS=DeepInfra,Together,Friendli

# ── Optional OpenRouter analytics headers ──────────────────────────────────
# OPENROUTER_SITE_URL=https://example.com/your-project
# OPENROUTER_APP_NAME=YourProjectName
